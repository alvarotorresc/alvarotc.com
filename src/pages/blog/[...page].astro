---
import BlogListingPage from '../../components/blog/BlogListingPage.astro';
import { getPosts } from '../../lib/posts';
import { paginateItems } from '../../lib/pagination';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  const pages = paginateItems(posts);
  return pages.map((p) => ({
    params: { page: p.page === 1 ? undefined : String(p.page) },
    props: { pageNum: p.page },
  }));
}

const { pageNum } = Astro.props as { pageNum: number };
const posts = await getPosts('en');
---

<BlogListingPage lang="en" posts={posts} page={pageNum} />
