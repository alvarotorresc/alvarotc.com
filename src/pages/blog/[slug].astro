---
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPosts, findTranslation, htmlPath } from '../../lib/posts';

export async function getStaticPaths() {
  const [posts, postsEs] = await Promise.all([getPosts('en'), getPosts('es')]);
  return posts.map((post, i) => {
    const translation = findTranslation(post, 'en', posts, postsEs);
    return {
      params: { slug: post.id },
      props: {
        post,
        prev: posts[i + 1],
        next: posts[i - 1],
        alternatePath: translation ? htmlPath(translation, 'es') : '/es/blog/',
        hasTranslation: Boolean(translation),
      },
    };
  });
}

const { post, prev, next, alternatePath, hasTranslation } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout
  post={post}
  lang="en"
  alternatePath={alternatePath}
  hasTranslation={hasTranslation}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</BlogPostLayout>
