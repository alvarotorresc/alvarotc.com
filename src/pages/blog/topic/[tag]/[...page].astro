---
import BlogListingPage from '../../../../components/blog/BlogListingPage.astro';
import { getPosts, tagCounts } from '../../../../lib/posts';
import { paginateItems } from '../../../../lib/pagination';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  const tags = tagCounts(posts);
  return tags.flatMap(({ tag }) => {
    const scoped = posts.filter((post) => post.data.tags.includes(tag));
    const pages = paginateItems(scoped);
    return pages.map((p) => ({
      params: { tag, page: p.page === 1 ? undefined : String(p.page) },
      props: { pageNum: p.page },
    }));
  });
}

const { tag } = Astro.params as { tag: string };
const { pageNum } = Astro.props as { pageNum: number };
const posts = await getPosts('en');
---

<BlogListingPage lang="en" posts={posts} page={pageNum} tag={tag} />
