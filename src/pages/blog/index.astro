---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/translations';
import { formatDate } from '../../lib/utils';

const lang = 'en';
const posts = (await getCollection('posts-en', (post) => !post.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title={t('writing.title', lang)} lang={lang}>
  <div class="container-page py-14">
    <div class="max-w-[720px]">
      <a href="/" class="mb-12 inline-block text-sm text-muted hover:text-accent">
        ← {t('nav.back', lang)}
      </a>

      <header class="mb-12 flex flex-col gap-2">
        <h1 class="text-3xl font-extrabold tracking-tight">{t('writing.title', lang)}</h1>
        <p class="text-sm text-faint">{t('writing.all', lang)}</p>
      </header>

      <ul class="flex flex-col">
        {
          posts.map((post) => (
            <li class="border-t border-border last:border-b">
              <a href={`/blog/${post.id}`} class="flex flex-col gap-1.5 py-4">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <span class="text-base font-bold leading-snug hover:text-accent">
                    {post.data.title}
                  </span>
                  <time
                    datetime={post.data.date.toISOString()}
                    class="shrink-0 font-mono text-xs text-faint"
                  >
                    {formatDate(post.data.date, lang)}
                  </time>
                </div>
                <p class="text-sm leading-relaxed text-muted">{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
