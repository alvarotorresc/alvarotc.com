---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Locale } from '../i18n/translations';

const langs: { lang: Locale; home: string }[] = [
  { lang: 'en', home: '/' },
  { lang: 'es', home: '/es/' },
];
---

<BaseLayout
  title={t('error.title', 'en')}
  description={t('error.description', 'en')}
  lang="en"
  alternatePath="/es/"
  noindex
>
  {
    langs.map(({ lang, home }) => (
      <div
        data-404-lang={lang}
        lang={lang}
        hidden={lang === 'es'}
        class="container-page flex flex-col items-start gap-4 py-20"
      >
        <p class="font-mono text-sm text-faint">404</p>
        <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{t('error.title', lang)}</h1>
        <p class="max-w-[520px] text-base leading-relaxed text-muted">{t('error.text', lang)}</p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href={home} class="btn-primary">
            {t('error.home', lang)}
          </a>
          <a href="https://status.alvarotc.com" class="btn-secondary">
            {t('error.status', lang)}
          </a>
        </div>
      </div>
    ))
  }
</BaseLayout>

<script>
  const lang = location.pathname.startsWith('/es/') ? 'es' : 'en';
  document.documentElement.lang = lang;
  document.querySelectorAll<HTMLElement>('[data-404-lang]').forEach((block) => {
    block.hidden = block.dataset['404Lang'] !== lang;
  });
</script>
