---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Locale } from '../i18n/translations';
import { getPosts, htmlPath } from '../lib/posts';
import { getProjects, projectSlug } from '../lib/projects';

const PAGES = ['/', '/about/', '/projects/', '/blog/', '/cv/', '/legal/', '/privacy/'];

const langs: { lang: Locale; home: string; routes: string[] }[] = await Promise.all(
  (['en', 'es'] as const).map(async (lang) => {
    const prefix = lang === 'es' ? '/es' : '';
    const posts = (await getPosts(lang)).map((post) => htmlPath(post, lang));
    const projects = (await getProjects(lang)).map(
      (project) => `${prefix}/projects/${projectSlug(project)}/`,
    );
    return {
      lang,
      home: `${prefix}/`,
      routes: [...PAGES.map((page) => `${prefix}${page}`), ...posts, ...projects],
    };
  }),
);
---

<BaseLayout
  title={t('error.title', 'en')}
  description={t('error.description', 'en')}
  lang="en"
  alternatePath="/es/"
  noindex
  bilingualChrome
>
  {
    langs.map(({ lang, home, routes }) => (
      <section
        data-404-lang={lang}
        data-title={t('error.title', lang)}
        data-routes={JSON.stringify(routes)}
        data-headline={t('error.headline', lang)}
        data-caret={t('error.caret', lang)}
        data-help={t('error.help', lang)}
        data-help-none={t('error.helpNone', lang)}
        data-note={t('error.note', lang)}
        data-go={t('error.go', lang)}
        lang={lang}
        hidden={lang === 'es'}
        class="container-page nf"
      >
        <h1 class="nf-title">
          <span class="nf-kind">error[E404]</span>:{' '}
          <span data-404-headline>{t('error.headlineFallback', lang)}</span>
        </h1>
        <pre class="nf-diag" data-404-diag aria-hidden="true" hidden />
        <p class="nf-text">{t('error.text', lang)}</p>
        <div class="flex flex-wrap gap-3">
          <a href={home} class="btn-secondary" data-404-suggest hidden />
          <a href={home} class="btn-primary" data-404-home>
            {t('error.home', lang)}
          </a>
          <a href="https://status.alvarotc.com" class="btn-secondary">
            {t('error.status', lang)}
          </a>
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    padding-block: clamp(56px, 12vh, 128px);
  }

  .nf-title {
    max-width: 30ch;
    font-family: var(--font-mono);
    font-size: clamp(22px, 2.8vw, 32px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .nf-kind {
    color: var(--color-danger);
  }

  .nf-diag {
    max-width: 100%;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: clamp(14px, 1.5vw, 17px);
    line-height: 1.75;
    color: var(--color-text);
  }

  .nf-diag :global(.g) {
    color: var(--color-accent);
  }

  .nf-diag :global(.c) {
    font-weight: 700;
    color: var(--color-danger);
  }

  .nf-diag :global(.h) {
    font-weight: 700;
    color: var(--color-ok);
  }

  .nf-diag :global(.n) {
    font-weight: 700;
  }

  .nf-diag :global(.m) {
    color: var(--color-muted);
  }

  .nf-diag :global(.w) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .nf-text {
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>

<script>
  type Part = [text: string, cls?: string];

  function levenshtein(a: string, b: string): number {
    const row = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      let prev = row[0];
      row[0] = i;
      for (let j = 1; j <= b.length; j++) {
        const next = row[j];
        row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
        prev = next;
      }
    }
    return row[b.length];
  }

  function normalize(path: string): string {
    const lower = path.toLowerCase().replace(/\/+/g, '/');
    return lower.endsWith('/') ? lower : `${lower}/`;
  }

  function closest(path: string, routes: string[]): string | undefined {
    const target = normalize(path);
    let best: string | undefined;
    let bestScore = Infinity;
    for (const route of routes) {
      const whole = levenshtein(target, route);
      const head =
        levenshtein(target, route.slice(0, target.length)) + (route.length - target.length) * 0.2;
      const score = Math.min(whole, route.length > target.length ? head : Infinity);
      if (score < bestScore) {
        bestScore = score;
        best = route;
      }
    }
    return bestScore <= Math.max(3, target.length * 0.5) ? best : undefined;
  }

  function caretRange(path: string, routes: string[]): [number, number] {
    let prefix = '';
    for (const segment of path.split('/')) {
      if (!segment) continue;
      const start = prefix.length + 1;
      prefix = `${prefix}/${segment}`;
      const probe = `${prefix.toLowerCase()}/`;
      if (!routes.some((route) => route.startsWith(probe))) return [start, segment.length];
    }
    return [0, path.length];
  }

  function line(parent: HTMLElement, parts: Part[]) {
    for (const [text, cls] of parts) {
      const span = document.createElement('span');
      span.textContent = text;
      if (cls) span.className = cls;
      parent.append(span);
    }
    parent.append('\n');
  }

  function render() {
    if (!document.querySelector('[data-404-lang]')) return;
    let path = location.pathname;
    try {
      path = decodeURIComponent(path);
    } catch {
      /* keep the raw path */
    }
    const lang = path === '/es' || path.startsWith('/es/') ? 'es' : 'en';
    document.documentElement.lang = lang;
    document.querySelectorAll<HTMLElement>('[data-chrome-lang]').forEach((chrome) => {
      chrome.hidden = chrome.dataset.chromeLang !== lang;
    });

    document.querySelectorAll<HTMLElement>('[data-404-lang]').forEach((block) => {
      block.hidden = block.dataset['404Lang'] !== lang;
      if (block.hidden) return;

      const d = block.dataset;
      const enTitle = document.querySelector<HTMLElement>('[data-404-lang="en"]')?.dataset.title;
      if (enTitle && d.title) document.title = document.title.replace(enTitle, d.title);
      const routes = JSON.parse(d.routes ?? '[]') as string[];
      const suggestion = closest(path, routes);
      const [start, length] = caretRange(path, routes);

      const headline = block.querySelector<HTMLElement>('[data-404-headline]');
      if (headline) headline.textContent = `${d.headline} \`${path}\``;

      const diag = block.querySelector<HTMLElement>('[data-404-diag]');
      if (diag) {
        line(diag, [
          ['  --> ', 'g'],
          [`alvarotc.com${path}:1:${start + 1}`, 'w'],
        ]);
        line(diag, [['   |', 'g']]);
        line(diag, [[' 1 | ', 'g'], [path]]);
        line(diag, [
          ['   | ', 'g'],
          [`${' '.repeat(start)}${'^'.repeat(length)} ${d.caret}`, 'c'],
        ]);
        line(diag, [['   |', 'g']]);
        if (suggestion) {
          line(diag, [
            ['help', 'h'],
            [`: ${d.help}`, 'w'],
          ]);
          line(diag, [['   |', 'g']]);
          line(diag, [
            [' 1 | ', 'g'],
            [suggestion, 'h'],
          ]);
          line(diag, [['   |', 'g']]);
        } else {
          line(diag, [
            ['help', 'h'],
            [`: ${d.helpNone}`, 'w'],
          ]);
          line(diag, [['   |', 'g']]);
        }
        line(diag, [
          ['   = ', 'g'],
          ['note', 'n'],
          [`: ${d.note} hello@alvarotc.com`, 'm w'],
        ]);
        diag.hidden = false;
      }

      const suggest = block.querySelector<HTMLAnchorElement>('[data-404-suggest]');
      const home = block.querySelector<HTMLAnchorElement>('[data-404-home]');
      if (suggestion && suggest && home) {
        suggest.href = suggestion;
        suggest.textContent = (d.go ?? '{path}').replace('{path}', suggestion);
        suggest.className = 'btn-primary';
        suggest.hidden = false;
        home.className = 'btn-secondary';
      }
    });
  }

  document.addEventListener('astro:page-load', render);
</script>
