---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/blog/PostList.astro';
import { t } from '../../../i18n/translations';
import { getReadingTime } from '../../../lib/utils';
import { getPosts, tagCounts } from '../../../lib/posts';

const lang = 'es';
const posts = await getPosts(lang);
const tags = tagCounts(posts);
const flatPosts = posts.map((post) => ({
  slug: post.id,
  href: `/es/blog/${post.id}`,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date,
  readingMinutes: getReadingTime(post.body ?? ''),
  tags: post.data.tags,
}));
---

<BaseLayout title={t('writing.title', lang)} lang={lang}>
  <div class="container-page py-14">
    <PostList lang={lang} posts={flatPosts} tags={tags} rssHref="/es/rss.xml" />
  </div>
</BaseLayout>
