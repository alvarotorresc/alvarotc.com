---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/translations';

const lang = 'es';
---

<BaseLayout
  title={t('error.title', lang)}
  description={t('error.description', lang)}
  lang={lang}
  alternatePath="/"
>
  <div class="container-page flex flex-col items-start gap-4 py-20">
    <p class="font-mono text-sm text-faint">404</p>
    <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{t('error.title', lang)}</h1>
    <p class="max-w-[520px] text-base leading-relaxed text-muted">{t('error.text', lang)}</p>
    <div class="mt-2 flex flex-wrap gap-3">
      <a href="/es/" class="btn-primary">{t('error.home', lang)}</a>
      <a href="https://status.alvarotc.com" class="btn-secondary">{t('error.status', lang)}</a>
    </div>
  </div>
</BaseLayout>
