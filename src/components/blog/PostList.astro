---
import TopicsFilter from './TopicsFilter.astro';
import { t, type Locale } from '../../i18n/translations';
import { formatShortDate } from '../../lib/utils';

interface FlatPost {
  slug: string;
  href: string;
  title: string;
  description: string;
  date: Date;
  readingMinutes: number;
  tags: string[];
}

interface Props {
  lang: Locale;
  posts: FlatPost[];
  tags: { tag: string; count: number }[];
  rssHref: string;
}

const { lang, posts, tags, rssHref } = Astro.props;
const total = posts.length;
const countOfTemplate = t('writing.countOf', lang);
const initialCountOf = countOfTemplate
  .replace('{shown}', String(total))
  .replace('{total}', String(total));
---

<div class="flex flex-col gap-8" data-post-list>
  <header class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div class="flex items-baseline gap-3">
      <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{t('writing.title', lang)}</h1>
      <p class="text-muted">
        <span data-header-count>{total}</span>
        {t('writing.count', lang)}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <TopicsFilter lang={lang} tags={tags} total={total} class="flex-1 sm:flex-none" />
      <a href={rssHref} class="btn-secondary h-10 shrink-0 gap-2">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span>{t('writing.rss', lang)}</span>
      </a>
    </div>
  </header>

  <section aria-label={t('writing.title', lang)} class="flex flex-col">
    {
      posts.map((post, i) => (
        <article
          data-tags={post.tags.join(' ')}
          class:list={[
            'grid grid-cols-1 gap-2 border-t border-border md:grid-cols-[160px_minmax(0,1fr)] md:gap-8',
            i === 0 ? 'py-8' : 'py-6',
            i === posts.length - 1 && 'border-b',
          ]}
        >
          <div class="flex gap-3 font-mono text-[13px] text-faint md:flex-col md:gap-1.5">
            <time datetime={post.date.toISOString()}>{formatShortDate(post.date, lang)}</time>
            <span>
              {post.readingMinutes} {t('post.minRead', lang)}
            </span>
          </div>
          <div class="flex flex-col gap-2">
            <h2
              class:list={[
                'font-extrabold tracking-tight leading-tight',
                i === 0 ? 'text-[34px]' : 'text-2xl font-bold',
              ]}
            >
              <a href={post.href} class="hover:text-accent">
                {post.title}
              </a>
            </h2>
            {post.tags.length > 0 && (
              <div class="flex flex-wrap gap-x-3.5 gap-y-1 font-mono text-[13px] text-faint">
                {post.tags.map((tag) => (
                  <a href={`?tag=${tag}`} data-filter-tag={tag} class="hover:text-text">
                    {tag}
                  </a>
                ))}
              </div>
            )}
            <p
              class:list={[
                'leading-relaxed',
                i === 0 ? 'text-lg text-muted' : 'text-base text-muted',
              ]}
            >
              {post.description}
            </p>
          </div>
        </article>
      ))
    }
    <div class="flex items-center justify-between pt-5 text-[13px]">
      <span
        class="font-mono text-faint"
        data-footer-count
        data-template={countOfTemplate}
        data-total={total}
      >
        {initialCountOf}
      </span>
    </div>
  </section>
</div>

<script>
  function apply(tag: string) {
    const root = document.querySelector<HTMLElement>('[data-post-list]');
    if (!root) return;

    const panelButtons = root.querySelectorAll<HTMLButtonElement>(
      '[data-tag-filter] button[data-tag]',
    );
    const articles = root.querySelectorAll<HTMLElement>('article[data-tags]');
    const summary = root.querySelector<HTMLElement>('[data-topics-filter] summary');
    const label = summary?.querySelector<HTMLElement>('[data-label]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear-filter]');
    const headerCount = root.querySelector<HTMLElement>('[data-header-count]');
    const footerCount = root.querySelector<HTMLElement>('[data-footer-count]');

    panelButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String((button.dataset.tag ?? '') === tag));
    });

    let shown = 0;
    articles.forEach((article) => {
      const tags = (article.dataset.tags ?? '').split(' ');
      const hide = tag !== '' && !tags.includes(tag);
      article.hidden = hide;
      if (!hide) shown += 1;
    });

    if (headerCount) headerCount.textContent = String(shown);

    if (footerCount) {
      const template = footerCount.dataset.template ?? '{shown}/{total}';
      const totalCount = footerCount.dataset.total ?? String(shown);
      footerCount.textContent = template
        .replace('{shown}', String(shown))
        .replace('{total}', totalCount);
    }

    if (summary && label) {
      const defaultLabel = summary.dataset.labelDefault ?? '';
      const activeTemplate = summary.dataset.labelActiveTemplate ?? '{tag}';
      label.textContent = tag ? activeTemplate.replace('{tag}', tag) : defaultLabel;
    }

    if (clearBtn) clearBtn.hidden = tag === '';
  }

  function bind() {
    const root = document.querySelector<HTMLElement>('[data-post-list]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';

    root
      .querySelectorAll<HTMLButtonElement>('[data-tag-filter] button[data-tag]')
      .forEach((button) => {
        button.addEventListener('click', () => apply(button.dataset.tag ?? ''));
      });

    root.querySelectorAll<HTMLAnchorElement>('a[data-filter-tag]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        apply(link.dataset.filterTag ?? '');
      });
    });

    root
      .querySelector<HTMLButtonElement>('[data-clear-filter]')
      ?.addEventListener('click', () => apply(''));

    const params = new URLSearchParams(window.location.search);
    const initialTag = params.get('tag');
    if (initialTag) apply(initialTag);
  }

  bind();
  document.addEventListener('astro:after-swap', bind);
</script>
