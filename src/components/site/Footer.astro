---
import { t, type Locale } from '../../i18n/translations';
import { mirroredPath } from '../../lib/i18n-paths';
import { getAuthor, getSocialLinks } from '../../lib/config';
import Icon from '../icons/Icon.astro';
import BrandIcon from '../icons/BrandIcon.astro';

interface Props {
  lang: Locale;
  currentPath: string;
  alternatePath?: string;
  analytics: boolean;
}
const { lang, currentPath, alternatePath, analytics } = Astro.props;
const otherLang = alternatePath ?? mirroredPath(lang, currentPath);

const author = getAuthor();
const social = getSocialLinks();
const github = social.find((s) => s.platform === 'github');
const linkedin = social.find((s) => s.platform === 'linkedin');
const x = social.find((s) => s.platform === 'twitter');

const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const socialLinks = [
  github && {
    href: github.url,
    icon: 'github' as const,
    brand: 'github' as const,
    label: t('footer.social.github', lang),
    handle: displayUrl(github.url),
  },
  linkedin && {
    href: linkedin.url,
    icon: 'linkedin' as const,
    brand: null,
    label: t('footer.social.linkedin', lang),
    handle: displayUrl(linkedin.url),
  },
  x && {
    href: x.url,
    icon: 'x' as const,
    brand: 'x' as const,
    label: t('footer.social.x', lang),
    handle: displayUrl(x.url),
  },
  {
    href: `mailto:${author.email}`,
    icon: 'mail' as const,
    brand: null,
    label: t('footer.social.email', lang),
    handle: author.email,
  },
].filter((s): s is Exclude<typeof s, false | undefined> => Boolean(s));

const prefix = lang === 'es' ? '/es' : '';
const sourceHref = `https://github.com/${author.github}/alvarotc.com`;
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="container-page flex flex-col gap-6 py-7 pb-10 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-2.5 text-[13px] text-faint">
      <span>{t(analytics ? 'footer.privacy' : 'footer.privacyNoAnalytics', lang)}</span>
      <div class="flex flex-wrap gap-4 font-medium">
        <a href={otherLang} class="hover:text-text">
          {t('footer.lang', lang)}
        </a>
        <a href={lang === 'es' ? '/es/rss.xml' : '/rss.xml'} class="hover:text-text">
          RSS
        </a>
        <a href={sourceHref} class="hover:text-text">
          {t('footer.source', lang)}
        </a>
        <a href={`${prefix}/privacy/`} class="hover:text-text">
          {t('footer.privacyPolicy', lang)}
        </a>
        <a href={`${prefix}/legal/`} class="hover:text-text">
          {t('footer.legal', lang)}
        </a>
        <a href="https://status.alvarotc.com" class="hover:text-text">
          {t('footer.status', lang)}
        </a>
      </div>
      <span>
        © {year} {author.name}
      </span>
    </div>
    <div class="flex gap-2.5">
      {socialLinks.map((s) => (
        <a
          href={s.href}
          title={s.handle}
          rel={s.icon === 'mail' ? undefined : 'me'}
          class="footer-social flex h-9 w-9 items-center justify-center rounded-full border border-border text-text"
        >
          <span class="sr-only">{`${s.label}, ${s.handle}`}</span>
          {s.brand ? (
            <BrandIcon slug={s.brand} size={20} />
          ) : (
            <Icon name={s.icon} size={20} strokeWidth={1.8} />
          )}
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer-social {
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .footer-social:hover,
  .footer-social:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-social {
      transition: none;
    }
  }
</style>
