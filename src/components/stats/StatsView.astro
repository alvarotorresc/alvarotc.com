---
import ContributionHeatmap from './ContributionHeatmap.astro';
import type { SentencePart, StatsPageView } from '../../lib/stats-view';
import { t } from '../../i18n/translations';

interface Props {
  view: StatsPageView;
}
const { view } = Astro.props;

const row =
  'grid grid-cols-1 gap-y-4 border-t border-border py-9 lg:grid-cols-[420px_minmax(0,1fr)] lg:gap-x-16';
const figureWrap = 'flex flex-col gap-2.5';
const contextWrap = 'flex flex-col gap-6 lg:pt-3.5';
const label = 'max-w-[340px] text-base font-semibold leading-[1.45] text-muted';
const context = 'max-w-[600px] text-lg leading-[1.6] text-muted';

const Sentence = (parts: SentencePart[]) =>
  parts
    .map((p) => (p.mono ? `<span class="font-mono text-text">${p.text}</span>` : p.text))
    .join('');
---

<div class="container-page flex flex-col gap-2 py-14">
  <header class="flex flex-col gap-5">
    <h1 class="text-[40px] font-extrabold leading-none tracking-[-0.03em] lg:text-[56px]">
      {view.title}
    </h1>
    <p class="max-w-[720px] text-lg leading-[1.6] text-muted">{view.subtitle}</p>
    {
      view.lastUpdatedLabel && (
        <span class="text-[13px] text-faint">
          {t('stats.lastUpdated', view.lang)}:{' '}
          <span class="font-mono text-text">{view.lastUpdatedLabel}</span>
        </span>
      )
    }
  </header>

  <main class="flex flex-col">
    {
      view.code && (
        <section class="flex flex-col">
          <div class="flex items-baseline justify-between gap-3 pt-14 pb-5">
            <h2 class="text-[28px] font-extrabold tracking-[-0.02em]">
              {t('stats.code', view.lang)}
            </h2>
            <a href={view.code.githubUrl} class="text-[13px] text-faint hover:text-text">
              {view.code.githubUrl.replace(/^https?:\/\//, '')}
            </a>
          </div>

          <div class={row}>
            <div class={figureWrap}>
              <span class="font-mono text-[64px] font-medium leading-[0.95] tracking-[-0.04em] lg:text-[88px]">
                {view.code.commits}
              </span>
              <span class={label}>{view.code.commitsLabel}</span>
            </div>
            <div class={contextWrap}>
              <p class={context} set:html={Sentence(view.code.contributionsIntro)} />
              <span class="text-xs font-bold text-faint">{view.code.contributionsHeading}</span>
              <ContributionHeatmap
                columns={view.code.heatmap.columns}
                monthLabels={view.code.heatmap.monthLabels}
                legend={view.code.heatmap.legend}
                ariaLabel={view.code.heatmap.ariaLabel}
                lang={view.lang}
              />
            </div>
          </div>

          <div class={row}>
            <div class={figureWrap}>
              <span class="font-mono text-[48px] font-medium leading-[0.95] tracking-[-0.04em] lg:text-[64px]">
                {view.code.repos}
              </span>
              <span class={label}>{view.code.reposLabel}</span>
            </div>
            <div class={contextWrap}>
              <p class={context}>{view.code.reposIntro}</p>
              {view.code.languages.length > 0 && (
                <div class="flex flex-col gap-4">
                  <div class="flex h-3 w-full gap-0.5">
                    {view.code.languages.map((l) => (
                      <div
                        class:list={['rounded-sm', l.isOther ? 'bg-surface-2' : 'bg-accent']}
                        style={`flex: ${l.percent} 1 0`}
                      />
                    ))}
                  </div>
                  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                    {view.code.languages.map((l) => (
                      <div class="flex flex-col gap-1">
                        <span class="flex items-center gap-2 text-sm font-semibold">
                          <span
                            class:list={[
                              'h-2.5 w-2.5 rounded-sm',
                              l.isOther ? 'bg-surface-2' : 'bg-accent',
                            ]}
                          />
                          {l.name}
                        </span>
                        <span class="pl-[18px] font-mono text-sm text-muted">{l.percent}%</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {(view.code.mostActiveRepo || view.code.stars) && (
                <div class="flex flex-col gap-2 text-[13px] text-faint sm:flex-row sm:gap-8">
                  {view.code.mostActiveRepo && (
                    <span set:html={Sentence(view.code.mostActiveRepo)} />
                  )}
                  {view.code.stars && <span set:html={Sentence(view.code.stars)} />}
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <section class="flex flex-col">
      <div class="flex items-baseline justify-between gap-3 pt-14 pb-5">
        <h2 class="text-[28px] font-extrabold tracking-[-0.02em]">
          {t('stats.writing', view.lang)}
        </h2>
      </div>

      <div class={row}>
        <div class={figureWrap}>
          <span
            class="font-mono text-[64px] font-medium leading-[0.95] tracking-[-0.04em] lg:text-[88px]"
          >
            {view.writing.posts}
          </span>
          <span class={label}>{view.writing.postsLabel}</span>
        </div>
        <div class={contextWrap}>
          <p class={context} set:html={Sentence(view.writing.wordsIntro)} />
          {
            view.writing.topics.length > 0 && (
              <div class="flex flex-wrap items-baseline gap-x-7 gap-y-2">
                {view.writing.topics.map((topic) => (
                  <span class="text-2xl font-bold tracking-[-0.02em] sm:text-[36px]">
                    {topic.tag}
                    <span class="ml-1.5 font-mono text-sm font-normal text-faint">
                      {topic.count}
                    </span>
                  </span>
                ))}
              </div>
            )
          }
          {
            view.writing.otherTopicsText && (
              <p class="text-[15px] leading-[1.6] text-muted">{view.writing.otherTopicsText}</p>
            )
          }
        </div>
      </div>

      {
        view.writing.views && (
          <div class={row}>
            <div class={figureWrap}>
              <span class="font-mono text-[48px] font-medium leading-[0.95] tracking-[-0.04em] lg:text-[64px]">
                {view.writing.views}
              </span>
              <span class={label}>{view.writing.viewsLabel}</span>
            </div>
            <div class={contextWrap}>
              {view.writing.viewsIntro && (
                <p class={context} set:html={Sentence(view.writing.viewsIntro)} />
              )}
              {view.writing.mostRead && (
                <ul class="flex flex-col">
                  {view.writing.mostRead.map((page) => (
                    <li class="grid grid-cols-1 items-baseline gap-2 border-t border-border py-3.5 sm:grid-cols-[minmax(0,1fr)_120px] sm:gap-6">
                      <a href={page.href} class="text-base font-semibold leading-[1.45]">
                        {page.title}
                      </a>
                      <span class="font-mono text-[15px] text-text sm:text-right">
                        {page.views}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        )
      }
    </section>

    <section class="flex flex-col">
      <div class="flex items-baseline justify-between gap-3 pt-14 pb-5">
        <h2 class="text-[28px] font-extrabold tracking-[-0.02em]">{t('stats.site', view.lang)}</h2>
      </div>
      <div class={row}>
        <div class={figureWrap}>
          <span
            class="font-mono text-[64px] font-medium leading-[0.95] tracking-[-0.04em] lg:text-[88px]"
          >
            {view.site.cookies}
          </span>
          <span class={label}>{view.site.cookiesLabel}</span>
        </div>
        <div class={contextWrap}>
          <p class={context} set:html={Sentence(view.site.thirdParty)} />
          {view.site.analyticsText && <p class={context}>{view.site.analyticsText}</p>}
        </div>
      </div>
    </section>
  </main>

  {
    view.sourcesText && (
      <p class="max-w-[640px] border-t border-border pt-8 text-sm leading-relaxed text-muted">
        {view.sourcesText}
      </p>
    )
  }
</div>
