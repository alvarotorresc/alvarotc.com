---
import * as simpleIcons from 'simple-icons';

interface Props {
  slug: string;
  size?: number;
  class?: string;
  brand?: boolean;
}

const { slug, size = 24, class: className = '', brand = false } = Astro.props;

const key = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`;
const icon = (
  simpleIcons as Record<string, { path: string; title: string; hex: string } | undefined>
)[key];
if (!icon) throw new Error(`Unknown brand icon: ${slug}`);

const [r, g, b] = [0, 2, 4].map((i) => parseInt(icon.hex.slice(i, i + 2), 16) / 255);
const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
const color = brand ? (luminance < 0.12 ? 'var(--text)' : `#${icon.hex}`) : undefined;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  style={color ? `color: ${color}` : undefined}
  aria-hidden="true"
>
  <path d={icon.path}></path>
</svg>
