---
interface Props {
  size?: number;
  class?: string;
}

const { size = 48, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <rect x="7" y="7" width="34" height="10" rx="2.5" fill="#c9cfd9"></rect>
  <rect x="7" y="19" width="34" height="10" rx="2.5" fill="#c9cfd9"></rect>
  <rect x="7" y="31" width="34" height="10" rx="2.5" fill="#c9cfd9"></rect>
  <circle cx="13" cy="12" r="2" fill="#5fd08a"></circle>
  <circle cx="13" cy="24" r="2" fill="#5fd08a"></circle>
  <circle cx="13" cy="36" r="2" fill="#f2b64e"></circle>
  <path
    d="M20 12 H35 M20 24 H35 M20 36 H35"
    fill="none"
    stroke="#0b0d11"
    stroke-width="2"
    stroke-linecap="round"></path>
</svg>
