---
import Tux from './Tux.astro';
import Lock from './Lock.astro';
import Cat from './Cat.astro';
import Megaphone from './Megaphone.astro';
import Construction from './Construction.astro';
import Guitar from './Guitar.astro';
import Chess from './Chess.astro';
import Boxing from './Boxing.astro';
import Leaf from './Leaf.astro';
import type { ColorIconName } from './tints';

interface Props {
  name: ColorIconName;
  size?: number;
  class?: string;
}

const { name, size = 48, class: className = '' } = Astro.props;

const components = {
  tux: Tux,
  lock: Lock,
  cat: Cat,
  megaphone: Megaphone,
  construction: Construction,
  guitar: Guitar,
  chess: Chess,
  boxing: Boxing,
  leaf: Leaf,
} satisfies Record<ColorIconName, unknown>;

const Component = components[name];
if (!Component) throw new Error(`Unknown color icon: ${name}`);
---

<Component size={size} class={className} />
