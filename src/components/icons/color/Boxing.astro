---
interface Props {
  size?: number;
  class?: string;
}

const { size = 48, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <rect x="13" y="5" width="25" height="28" rx="11" fill="#e5645a"></rect>
  <ellipse cx="13" cy="21" rx="5.5" ry="7.5" fill="#e5645a"></ellipse>
  <path
    d="M17.5 14 Q15.5 21 17.5 28"
    fill="none"
    stroke="#0b0d11"
    stroke-width="1.6"
    stroke-linecap="round"></path>
  <path
    d="M21 10 Q26 7.5 31 10"
    fill="none"
    stroke="#f4f2ec"
    stroke-width="2"
    stroke-linecap="round"></path>
  <rect x="15" y="31" width="21" height="12" rx="3" fill="#f4f2ec"></rect>
  <rect x="15" y="35" width="21" height="3" fill="#e5645a"></rect>
</svg>
