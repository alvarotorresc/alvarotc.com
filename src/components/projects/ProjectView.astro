---
import ProjectHeader from './ProjectHeader.astro';
import ProjectScreens from './ProjectScreens.astro';
import ProjectTools from './ProjectTools.astro';
import ProjectFeatures from './ProjectFeatures.astro';
import ProjectWhy from './ProjectWhy.astro';
import ProjectPlayground from './ProjectPlayground.astro';
import ProjectHistory from './ProjectHistory.astro';
import { t } from '../../i18n/translations';
import { hasLightbox, type ProjectView } from '../../lib/project-view';

interface Props {
  view: ProjectView;
}
const { view } = Astro.props;
const { lang } = view;
---

<div class="container-page" data-project={view.kind}>
  <ProjectHeader view={view} />
  <ProjectScreens view={view} />
  <ProjectTools view={view} />
  <ProjectFeatures view={view} />
  <ProjectWhy view={view}><slot /></ProjectWhy>
  <ProjectPlayground view={view} />
  <ProjectHistory view={view} />
</div>

{
  hasLightbox(view) && (
    <dialog class="lightbox" aria-labelledby="lightbox-caption">
      <figure class="lightbox-figure">
        <img class="lightbox-img" alt="" data-lightbox-img />
        <figcaption id="lightbox-caption" class="text-sm text-muted" data-lightbox-caption />
      </figure>
      <button
        type="button"
        class="lightbox-btn lightbox-close"
        data-lightbox-close
        aria-label={t('lightbox.close', lang)}
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="m3.5 3.5 9 9" />
          <path d="m12.5 3.5-9 9" />
        </svg>
      </button>
      <button
        type="button"
        class="lightbox-btn lightbox-prev"
        data-lightbox-prev
        aria-label={t('lightbox.prev', lang)}
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M10 3.5 5.5 8l4.5 4.5" />
        </svg>
      </button>
      <button
        type="button"
        class="lightbox-btn lightbox-next"
        data-lightbox-next
        aria-label={t('lightbox.next', lang)}
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 3.5 10.5 8 6 12.5" />
        </svg>
      </button>
    </dialog>
  )
}

<script>
  function bindLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = 'true';
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const close = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    if (!img || !caption || !prev || !next || !close) return;

    const triggers = [...document.querySelectorAll<HTMLButtonElement>('button[data-lightbox]')];
    let group: HTMLButtonElement[] = [];
    let index = 0;
    let opener: HTMLButtonElement | undefined;

    const show = (i: number) => {
      index = (i + group.length) % group.length;
      const trigger = group[index];
      img.src = trigger.dataset.full ?? '';
      img.alt = trigger.dataset.alt ?? '';
      caption.textContent = trigger.dataset.caption ?? '';
      prev.hidden = group.length < 2;
      next.hidden = group.length < 2;
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        opener = trigger;
        group = triggers.filter((t) => t.dataset.lightbox === trigger.dataset.lightbox);
        show(group.indexOf(trigger));
        document.body.classList.add('lightbox-open');
        dialog.showModal();
      });
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (group.length < 2) return;
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => {
      document.body.classList.remove('lightbox-open');
      img.removeAttribute('src');
      opener?.focus();
    });
  }
  bindLightbox();
  document.addEventListener('astro:after-swap', bindLightbox);
</script>

<style>
  :global(body.lightbox-open) {
    overflow: hidden;
  }
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 16px;
    border: 0;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    color: var(--text);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: lightbox-in 150ms ease-out;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin: 0;
  }
  .lightbox-img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(96vw, 1600px);
    max-height: 86vh;
    object-fit: contain;
    border-radius: 12px;
  }
  .lightbox-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .lightbox-btn[hidden] {
    display: none;
  }
  .lightbox-close {
    top: 16px;
    right: 16px;
  }
  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-prev {
    left: 16px;
  }
  .lightbox-next {
    right: 16px;
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
  }
</style>
