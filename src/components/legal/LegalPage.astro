---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, type Locale } from '../../i18n/translations';

interface Props {
  lang: Locale;
  page: 'privacy' | 'notice';
  updated: string;
}
const { lang, page, updated } = Astro.props;
const title = t(`legal.${page}.title`, lang);
const updatedLabel = new Date(`${updated}T00:00:00Z`).toLocaleDateString(
  lang === 'es' ? 'es-ES' : 'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' },
);
---

<BaseLayout title={title} description={t(`legal.${page}.description`, lang)} lang={lang}>
  <article class="container-page py-16 md:py-20">
    <div class="max-w-[680px]">
      <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{title}</h1>
      <p class="mt-3 font-mono text-sm text-faint">
        {t('legal.updated', lang)}: <time datetime={updated}>{updatedLabel}</time>
      </p>
      <div class="legal prose mt-10">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal :global(ul) {
    list-style: disc;
  }
</style>
