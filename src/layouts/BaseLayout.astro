---
import '@fontsource-variable/manrope';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import CommandPalette from '../components/islands/CommandPalette';
import { getSiteName, getDescription, getAuthor } from '../lib/config';
import { getExperience, hasMockExperience } from '../lib/experience';
import { mirroredPath } from '../lib/i18n-paths';
import { t, type Locale } from '../i18n/translations';

interface HreflangLink {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  markdownAlternate?: string;
  lang?: Locale;
  alternatePath?: string;
  hreflangLinks?: HreflangLink[];
  ogLocaleAlternate?: string | null;
  jsonLd?: Record<string, unknown>;
  prevHref?: string;
  nextHref?: string;
  noindex?: boolean;
}

const currentPath = Astro.url.pathname;
const {
  title,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  markdownAlternate,
  lang = currentPath.startsWith('/es') ? 'es' : 'en',
  alternatePath,
  hreflangLinks,
  jsonLd,
  prevHref,
  nextHref,
  noindex,
} = Astro.props;
const description = Astro.props.description ?? getDescription(lang);
const umamiWebsiteId: string | undefined = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || undefined;

const canonicalURL = new URL(currentPath, Astro.site);
const ogImage = new URL(image, Astro.site);
const siteName = getSiteName();
const author = getAuthor();
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

const alternate = alternatePath ?? mirroredPath(lang, currentPath);
const alternateURL = new URL(alternate, Astro.site);
const experienceVisible = !hasMockExperience(await getExperience());

const links: HreflangLink[] = hreflangLinks ?? [
  { lang, href: canonicalURL.toString() },
  { lang: lang === 'es' ? 'en' : 'es', href: alternateURL.toString() },
  {
    lang: 'x-default',
    href: lang === 'en' ? canonicalURL.toString() : alternateURL.toString(),
  },
];

const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlternate =
  'ogLocaleAlternate' in Astro.props
    ? Astro.props.ogLocaleAlternate
    : lang === 'es'
      ? 'en_US'
      : 'es_ES';

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
  name: title,
  description,
  url: canonicalURL.toString(),
  image: ogImage.toString(),
  author: { '@type': 'Person', name: author.name, url: new URL('/', Astro.site).toString() },
  ...(publishedTime && { datePublished: publishedTime }),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f1115" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {prevHref && <link rel="prev" href={new URL(prevHref, Astro.site)} />}
    {nextHref && <link rel="next" href={new URL(nextHref, Astro.site)} />}
    {links.map((l) => <link rel="alternate" hreflang={l.lang} href={l.href} />)}
    {markdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} · ${lang === 'es' ? 'Artículos' : 'Writing'}`}
      href={lang === 'es' ? '/es/rss.xml' : '/rss.xml'}
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author.name} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternate && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && <meta property="article:author" content={author.name} />}
    {tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function () {
        window.__applyTheme = function (theme) {
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0f1115' : '#f7f8fa');
        };
        function apply() {
          var theme = 'dark';
          try {
            var stored = localStorage.getItem('theme');
            if (stored === 'light' || stored === 'dark') theme = stored;
            else theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          } catch {
            /* keep default */
          }
          window.__applyTheme(theme);
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? defaultJsonLd)} />

    <ClientRouter />
    {
      umamiWebsiteId && (
        <script
          is:inline
          defer
          src="https://analytics.alvarotc.com/script.js"
          data-website-id={umamiWebsiteId}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-accent-fg"
    >
      {t('nav.skip', lang)}
    </a>
    <Nav
      lang={lang}
      currentPath={currentPath}
      alternatePath={alternate}
      experienceVisible={experienceVisible}
    />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer
      lang={lang}
      currentPath={currentPath}
      alternatePath={alternate}
      analytics={Boolean(umamiWebsiteId)}
    />
    <CommandPalette client:idle lang={lang} />
  </body>
</html>
