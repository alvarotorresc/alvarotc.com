{
  "name": "alvarotc-web",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "translate": "node scripts/translate.js",
    "stats": "node --env-file-if-exists=.env scripts/fetch-data.mjs",
    "og:default": "node --experimental-strip-types scripts/og-default.mjs",
    "icons": "node scripts/icons.mjs",
    "csp:hashes": "node scripts/csp-hashes.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "deepl-node": "^1.28.0",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.11.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "simple-icons": "^16.32.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,css}": "prettier --write"
  }
}
