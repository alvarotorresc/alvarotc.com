# Check if there are staged changes in src/content/posts/
POSTS_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep "^src/content/posts/.*\.md$" || true)

if [ -n "$POSTS_CHANGED" ]; then
  echo "📝 Posts en español detectados, traduciendo solo los del commit..."
  # shellcheck disable=SC2086
  npm run translate -- $POSTS_CHANGED
  git add src/content/posts-en/
  echo "✅ Traducciones añadidas al commit"
fi

# Format and lint staged files
npx lint-staged
